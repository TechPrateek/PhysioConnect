# ==========================================
# PhysioConnect Environment Configuration
# Launch Territory: Etawah, Uttar Pradesh
# ==========================================

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/physioconnect?schema=public"

# Better Auth Configuration
BETTER_AUTH_SECRET="physioconnect-super-secret-key-min-32-chars-length"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth (Optional in local development)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Razorpay Payment Gateway (Test Mode)
RAZORPAY_KEY_ID="rzp_test_mock_physio_connect"
RAZORPAY_KEY_SECRET="mock_razorpay_secret_key"
RAZORPAY_WEBHOOK_SECRET="mock_webhook_secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_mock_physio_connect"

# Territory Config
NEXT_PUBLIC_CITY_NAME="Etawah"
NEXT_PUBLIC_STATE_NAME="Uttar Pradesh"
